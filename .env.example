# Copy to .env, fill in Firebase Console values, then restart Vite.
# VITE_* values are exposed in the browser bundle; do not put private keys here.
# Required: API_KEY, PROJECT_ID, STORAGE_BUCKET, APP_ID.
# AUTH_DOMAIN and MESSAGING_SENDER_ID are optional for this Storage-only app.
# STORAGE_BUCKET is the bucket name from Firebase Console, without gs://.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
